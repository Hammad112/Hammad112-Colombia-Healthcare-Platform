# Copy to .env for local development. NEVER commit .env (see .gitignore).
# Production values come from the secrets manager at runtime, not from this file (ADR-10).

APP_ENV=local
LOG_LEVEL=INFO

# Database
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=clinic
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application role used by the API. Holds INSERT-only rights on the audit schema.
APP_DB_USER=clinic_app
APP_DB_PASSWORD=change-me-locally

# Column encryption (ADR: PHI encrypted at rest).
# Local development keys ONLY. Generate real ones into the secrets manager:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
PHI_ENCRYPTION_KEY=local-dev-key-not-for-production-0000
PHI_BLIND_INDEX_KEY=local-dev-bidx-not-for-production-000

# ADR-11: hard gate. Must stay false until the compliance package is signed.
ALLOW_REAL_PATIENT_DATA=false

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
